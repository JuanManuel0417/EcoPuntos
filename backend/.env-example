# Copia este archivo y renómbralo a .env

PORT=4000

# URL de MongoDB Atlas. La base de datos del proyecto se llama "ecopuntos" (va antes del ?).
MONGODB_URI=mongodb+srv://USUARIO:CLAVE@CLUSTER.mongodb.net/ecopuntos?retryWrites=true&w=majority

# Clave para firmar los tokens JWT (escribe una cadena larga y aleatoria)
JWT_SECRET=cambia_esta_clave_por_una_larga_y_aleatoria
JWT_EXPIRA=8h

# Dirección del frontend (React) que puede consumir la API
FRONTEND_URL=http://localhost:5173
